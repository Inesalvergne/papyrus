
<%= turbo_frame_tag @book, :edit_title do %>
  <h1><%= @book.title %></h1>

  <% if Current.user&.admin? %>
    <p><%= link_to "edit", edit_book_title_path(@book) %></p>
  <% end %>
<% end %>

<p><%= @book.display_authors %></p>

<p><%= @book.summary %></p>

<p><%= "#{@book.first_publish_year}, #{@book.pages} pages" %></p>
